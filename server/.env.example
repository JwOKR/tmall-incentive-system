# Database
DATABASE_URL=mysql://tmall:tmall2026@localhost:3306/tmall_incentive

# Server
PORT=3001
NODE_ENV=development

# Express 信任几跳反向代理（默认 1 = 前端容器的那一跳 nginx）
# 这个值决定 req.ip 的取值，进而决定审计日志里记录的 IP 是否可信。
# 1：直连 nginx（默认部署：浏览器 → 前端容器 nginx → api 容器）
# 2：nginx 前面还有一跳（例如 Cloudflare Tunnel）
# 0：api 容器被直接暴露、前面没有任何代理
# ⚠️ 配错的表现：日志里的 IP 全部是内网地址（配大了）或可被请求头伪造（配小了）。
# TRUST_PROXY_HOPS=1

# JWT 签名密钥（必填）
# 未设置时会回退到源码内置的公开默认值，届时任何人都能伪造任意用户（含管理员）的 JWT。
# 生成示例：openssl rand -base64 48
JWT_SECRET=

# 首次部署时用于创建默认管理员（仅当该用户名尚不存在时生效）
# 不设置密码时会使用源码内置默认值，并会在日志中给出告警
# ADMIN_USERNAME=JIA
# ADMIN_PASSWORD=

# 自动维护（定时自动备份 + 180 天日志保留）
# 默认【关闭】；生产如需开启请置 true（或后台「系统设置」把 auto_backup_enabled 置 true）。
# 说明：备份为容器内文件，未挂载卷时【容器重建会丢失】，仅作短期兜底，请勿当唯一备份。
# AUTO_BACKUP_ENABLED=false
# 备份落盘目录（默认相对当前工作目录的 ./backups，容器内通常为 /app/backups）
# BACKUP_DIR=./backups
# 备份间隔毫秒（默认 86400000 = 24h，最小 60000=1min）
# AUTO_BACKUP_INTERVAL_MS=86400000
# 备份滚动保留份数（1-30，默认 7）与日志保留天数（7-3650，默认 180）也可在「系统设置」里改
# BACKUP_RETENTION_COUNT=7
# LOG_RETENTION_DAYS=180
