# Database
DATABASE_URL=mysql://tmall:tmall2026@localhost:3306/tmall_incentive

# Server
PORT=3001
NODE_ENV=development

# JWT 签名密钥（必填）
# 未设置时会回退到源码内置的公开默认值，届时任何人都能伪造任意用户（含管理员）的 JWT。
# 生成示例：openssl rand -base64 48
JWT_SECRET=

# 首次部署时用于创建默认管理员（仅当该用户名尚不存在时生效）
# 不设置密码时会使用源码内置默认值，并会在日志中给出告警
# ADMIN_USERNAME=JIA
# ADMIN_PASSWORD=
